@using Quki.Entity.ViewModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutTikutu.cshtml";
}
@* 
@await Component.InvokeAsync("HomeSlider")

 *@
@model MenuViewModel
<style>
    html, body {
        overflow-x: hidden;
    }

    html, body {
        overflow-x: hidden;
    }

    .category-wrapper {
        width: 100%;
        margin: 10px;
    }

    .category-nav {
        display: flex;
        flex-wrap: wrap;
        width: 100%;
        gap: 10px;
    }

        .category-nav .nav-item {
            flex: 0 0 auto;
        }

        .category-nav .nav-link {
            white-space: nowrap;
            margin-bottom: 10px;
        border: 1px solid #91ad41;
        border-radius: 5px;
    }
        }

    .category-wrapper::-webkit-scrollbar {
        display: none;
    }

    .menu-title-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #e5e5e5;
        padding-bottom: 6px;
        margin-bottom: 6px;
    }

    .product-name {
        font-size: 18px;
        font-weight: 600;
        margin: 0;
    }

    .product-price {
        font-weight: 700;
        font-size: 18px;
        white-space: nowrap;
    }

    .menu-desc {
        font-size: 14px;
        color: #666;
        text-align: left;
    }

    .nav-pills .nav-link.active, .nav-pills .show > .nav-link {
        color: #fff;
        background-color: #91ad41;
    }

    .menu-detail {
        margin-top: 8px;
    }

        .menu-detail em {
            display: block;
            margin-bottom: 6px;
            font-style: italic;
        }

        .menu-detail ul {
            padding-left: 20px;
            margin: 0;
        }

        .menu-detail li {
            margin-bottom: 4px;
            list-style: outside;
        }

    .firin-img-wrap {
        position: relative;
        width: 100%;
        height: 200px;
        border-radius: 14px;
        overflow: hidden;
        margin-bottom: 12px;
    }

    .firin-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
        transition: transform 0.35s ease;
    }

    .firin-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0);
        transition: background 0.35s ease;
        border-radius: 14px;
    }

    .item:hover .firin-img-wrap img {
        transform: scale(1.05);
    }

    .item:hover .firin-overlay {
        background: rgba(0, 0, 0, 0.22);
    }
</style>
<section>
    <div class="section feature-products">


        <div class="category-wrapper">
            <div class="flex-t-center">
                <ul class="nav nav-pills category-nav" role="tablist">
                    @{
                        int j = 0;
                        string show2 = "name-tab nav-link";
                    }
                    @foreach (var item in Model.sluDefModels.Where(x => (x.parent_slu_def_no  == null || x.parent_slu_def_no==0)))
                    {
                        if (j == 0)
                        {
                            show2 = "name-tab nav-link active show";
                        }
                        else
                        {
                            show2 = "name-tab nav-link";
                        }
                        <li class="nav-item">
                            <a class="@show2" data-toggle="pill" href="#@item.slu_def_seq">@item.slu_def_name.ToUpper()</a>
                        </li>
                        j++;
                    }


                </ul>
            </div>
        </div>
        <div class="tab-content m-top">
            <!-- All -->
            @{
                int i = 0;
                string show = "";
            }
            @foreach (var item in Model.sluDefModels.Where(x => (x.parent_slu_def_no == null || x.parent_slu_def_no == 0)))
            {
                if (i == 0)
                {
                    show = "in active show";
                }
                else
                {

                    show = "";
                }
                <div class="tab-pane fade @show" id="@item.slu_def_seq">
                    <div class="product">
                        <div class="row">
                            <!-- Dish #1 -->
                            @{
                                var sluItem = Model.getMenuItems.Where(x => x.slu_def_seq_view == item.slu_def_seq).ToList();
                                int sluItemIndex = 0;

                                if (sluItemIndex == 0)
                                {

                                    var sluParentValue = Model.sluDefModels.Where(x => x.parent_slu_def_no == item.slu_def_seq).FirstOrDefault();
                                    if (sluParentValue != null)
                                    {
                                        <h5 style="margin-left:50px">@sluParentValue.slu_def_name</h5>
                                    }
                                }
                        
    }
                            @foreach (var itemSlu in sluItem)
                            {
                                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12">
                                    <div class="item item-hover-view-cart">
                                        <div class="firin-img-wrap">
                                            <img src="/icons/@(string.IsNullOrEmpty(itemSlu.mi_icon_path) ? "branchlogo.png" : itemSlu.mi_icon_path)" alt="@itemSlu.mi_master_def_name" onerror="this.onerror=null;this.src='/icons/branchlogo.png'">
                                            <div class="firin-overlay"></div>
                                        </div>

                                        <div class="product-info text-center">
                                            <div class="menu-title-row">
                                                <h4 class="product-name">
                                                    @itemSlu.mi_master_def_name
                                                </h4>

                                                <span class="product-price">
                                                    @string.Format(new System.Globalization.CultureInfo("tr-TR"), "{0:C}", itemSlu.mi_price)
                                                </span>
                                            </div>

                                            <div class="menu-desc">
                                                @Html.Raw(itemSlu.rvc_mi_third_name)
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- .dish-panel end -->
                            }
                            <!-- Dish #2 -->
                        </div>

                        <!-- .row end -->
                    </div>

                    <!-- .container end -->
                </div>
                i++;
            }
        </div>
    </div>
</section>












